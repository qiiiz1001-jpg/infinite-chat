{
  "version": "3.7",
  "services": {
    "mysql": {
      "image": "docker.m.daocloud.io/library/mysql:8.0.41",
      "environment": {
        "MYSQL_ROOT_PASSWORD": "${DB_PASSWORD}",
        "MYSQL_DATABASE": "${DB_NAME:-Qingliao}",
        "TZ": "Asia/Shanghai"
      },
      "ports": [
        "127.0.0.1:13307:3306"
      ],
      "volumes": [
        "integrated-mysql:/var/lib/mysql",
        "./generated/mysql:/docker-entrypoint-initdb.d:ro"
      ],
      "command": [
        "--server-id=1",
        "--log-bin=mysql-bin",
        "--binlog-format=ROW",
        "--binlog-row-image=FULL"
      ],
      "restart": "unless-stopped"
    },
    "redis": {
      "image": "docker.m.daocloud.io/library/redis:7.2.7-alpine",
      "command": [
        "redis-server",
        "--appendonly",
        "yes",
        "--requirepass",
        "${REDIS_PASSWORD}"
      ],
      "ports": [
        "127.0.0.1:16379:6379"
      ],
      "volumes": [
        "integrated-redis:/data"
      ],
      "restart": "unless-stopped"
    },
    "postgres": {
      "image": "docker.m.daocloud.io/paradedb/paradedb:0.26.7-pg16",
      "environment": {
        "POSTGRES_USER": "${PGVECTOR_USER:-chat}",
        "POSTGRES_PASSWORD": "${PGVECTOR_PASSWORD}",
        "POSTGRES_DB": "${PGVECTOR_DATABASE:-chat_vectors}"
      },
      "ports": [
        "127.0.0.1:15432:5432"
      ],
      "volumes": [
        "integrated-postgres:/var/lib/postgresql/data",
        "./integrated-postgres/01-databases.sql:/docker-entrypoint-initdb.d/01-databases.sql:ro",
        "../database/postgres/03-scoped-knowledge.sql:/docker-entrypoint-initdb.d/03-scoped-knowledge.sql:ro"
      ],
      "restart": "unless-stopped"
    },
    "kafka": {
      "image": "docker.m.daocloud.io/apache/kafka:3.9.0",
      "ports": [
        "127.0.0.1:19092:9092"
      ],
      "environment": {
        "KAFKA_NODE_ID": "1",
        "KAFKA_PROCESS_ROLES": "broker,controller",
        "KAFKA_LISTENERS": "PLAINTEXT://:9092,CONTROLLER://:9093",
        "KAFKA_ADVERTISED_LISTENERS": "PLAINTEXT://localhost:19092",
        "KAFKA_CONTROLLER_LISTENER_NAMES": "CONTROLLER",
        "KAFKA_LISTENER_SECURITY_PROTOCOL_MAP": "CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT",
        "KAFKA_CONTROLLER_QUORUM_VOTERS": "1@kafka:9093",
        "KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR": "1",
        "KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR": "1",
        "KAFKA_TRANSACTION_STATE_LOG_MIN_ISR": "1",
        "KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS": "0",
        "KAFKA_HEAP_OPTS": "-Xms256m -Xmx512m"
      },
      "restart": "unless-stopped"
    },
    "minio": {
      "image": "dappros/minio@sha256:624bad2fe79a8613aa3c5c9b765ebcab365080b8445cf1b05c357cc7753725f0",
      "command": [
        "server",
        "/data",
        "--console-address",
        ":9001"
      ],
      "environment": {
        "MINIO_ROOT_USER": "${MINIO_ACCESS_KEY:-minioadmin}",
        "MINIO_ROOT_PASSWORD": "${MINIO_SECRET_KEY}"
      },
      "ports": [
        "127.0.0.1:19000:9000",
        "127.0.0.1:19001:9001"
      ],
      "volumes": [
        "integrated-minio:/data"
      ],
      "restart": "unless-stopped"
    },
    "nacos": {
      "image": "docker.m.daocloud.io/nacos/nacos-server:v3.0.3",
      "environment": {
        "MODE": "standalone",
        "NACOS_AUTH_ENABLE": "false",
        "JVM_XMS": "256m",
        "JVM_XMX": "512m",
        "JVM_XMN": "128m",
        "NACOS_AUTH_TOKEN": "${JWT_SECRET_BASE64}",
        "NACOS_AUTH_IDENTITY_KEY": "projectServer",
        "NACOS_AUTH_IDENTITY_VALUE": "${INTERNAL_TOKEN}"
      },
      "ports": [
        "127.0.0.1:18848:8848",
        "127.0.0.1:19848:9848",
        "127.0.0.1:18880:8080"
      ],
      "restart": "unless-stopped"
    }
  },
  "volumes": {
    "integrated-mysql": {},
    "integrated-redis": {},
    "integrated-postgres": {},
    "integrated-minio": {}
  }
}
